# -----------------------------------------------------------------------
# Шаблон переменных окружения для AI Microservice
# Скопируйте файл в .env и заполните реальными значениями:
#   cp env.example .env
# Файл .env НЕ коммитится в репозиторий (он в .gitignore).
# -----------------------------------------------------------------------

# Строка подключения к PostgreSQL.
# Хост — имя сервиса из docker-compose (postgres_db), НЕ localhost.
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres_db:5432/my_service_db

# URL внешнего источника данных (откуда сервис получает задачи).
API_URL=https://api.example.com/v1/tasks

# URL внешнего приёмника результатов (куда сервис отправляет ответы).
RESULT_URL=https://api.example.com/v1/results

# Ключ OpenAI (оставьте пустым в репозитории)
OPENAI_API_KEY=
MODEL=gpt-4o-mini
PROMPT=Определи тональность отзыва. Ответь строго одним словом: positive, negative или neutral.
TEST_MODE=False
