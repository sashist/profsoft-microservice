# -----------------------------------------------------------------------
# Шаблон переменных окружения для AI Microservice
# -----------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg2://postgres:password@postgres_db:5432/my_service_db
API_URL=https://api.example.com/v1/tasks
RESULT_URL=https://api.example.com/v1/results

# Настройки LLM & Embedding (По умолчанию включен автономный TEST_MODE=True)
OPENAI_API_KEY=test-key
GEMINI_API_KEY=
MODEL=gemini-2.5-flash
PROMPT=Определи тональность отзыва. Ответь строго одним словом: positive, negative или neutral.

# В автономном тестовом режиме НЕ ТРЕБУЮТСЯ API-ключи
TEST_MODE=True

EMBED_MODEL=gemini-embedding-001
EMBED_DIM=3072
CHAT_MODEL=gemini-2.5-flash
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TOP_K=5
MIN_RETRIEVAL_SCORE=0.1
QDRANT_URL=http://qdrant:6333
COLLECTION=docs
